# Copy this file to ".env" and fill in your own Supabase project values.
# Find them in your Supabase project: Settings -> API.
# These are PUBLIC client values (protected by Row Level Security), safe to bundle into the app.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
